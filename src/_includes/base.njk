<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title data-en="{{ title.en }}" data-es="{{ title.es }}">{{ title.en }}</title>
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<meta name="color-scheme" content="dark">
<link rel="stylesheet" href="assets/css/main.css">
{#- En el head para saber si hay partida guardada antes de pintar nada #}
{% js "store" %}
</head>
<body>
{{ content | safe }}
{% include "components/footer.njk" %}
{# Scripts clásicos y en línea (shortcode js): funcionan con doble clic en _site/index.html y nunca se mezclan versiones #}
{% js "lang" %}
{%- for s in scripts %}
{% js s %}
{%- endfor %}
</body>
</html>
