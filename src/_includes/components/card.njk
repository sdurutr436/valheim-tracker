{#- Card con receta desplegable (cocina, Artisan, Carpenter). Usa r (fila), ns, s (sección) y loop -#}
{%- set id = ns + '-' + s.biome.slug + '-' + loop.index %}
{%- set w = r.wiki or r.name %}
<article class="food" data-key="{{ r.key }}">
  <button class="food-head" type="button" aria-expanded="false" aria-controls="detail-{{ id }}">
    <span class="food-img">
      <span class="ph" aria-hidden="true">{{ r.name | first }}</span>
      {#- Alquimista: icono de la base hasta marcarla Preparada; después, el de la bebida (lo cambia el CSS) #}
      {% if r.baseImage %}<img class="img-base" src="{{ r.baseImage }}" alt="" width="48" height="48" loading="lazy" onerror="this.remove()">{% endif %}
      {% if r.image %}<img{% if r.baseImage %} class="img-made"{% endif %} src="{{ r.image }}" alt="" width="48" height="48" loading="lazy" onerror="this.remove()">{% endif %}
    </span>
    <span class="nm food-name" data-en="{{ r.name }}"{% if r.nameEs %} data-es="{{ r.nameEs }}"{% endif %}>{{ r.name }}</span>
    <span class="chev" aria-hidden="true">▾</span>
  </button>
  <div class="checks">
    {%- for p in tracker.pills[ns] %}{% if not p.field or r[p.field] %}
    <label class="pill" data-k="{{ p.k }}"><input type="checkbox" data-k="{{ p.k }}"><span data-en="{{ p.label.en }}" data-es="{{ p.label.es }}">{{ p.label.en }}</span></label>
    {%- endif %}{% endfor %}
  </div>
  <div class="food-detail" id="detail-{{ id }}" hidden>
    {% if r.recipe %}
      <p class="station"><span data-en="{{ r.recipe.station or 'Recipe' }}" data-es="{{ r.recipe.stationEs or ('Receta' if not r.recipe.station) }}">{{ r.recipe.station or 'Recipe' }}</span>{% if r.recipe.level %} <small><span data-en="level" data-es="nivel">level</span> {{ r.recipe.level }}</small>{% endif %}{% if r.recipe.yield > 1 %} <small><span data-en="makes" data-es="rinde">makes</span> {{ r.recipe.yield }}</small>{% endif %}</p>
      <ul class="ingredients">
        {%- for ing in r.recipe.ingredients %}
        <li>
          {% if ing.image %}<img src="{{ ing.image }}" alt="" width="24" height="24" loading="lazy" onerror="this.remove()">{% endif %}
          <span data-en="{{ ing.name }}"{% if ing.nameEs %} data-es="{{ ing.nameEs }}"{% endif %}>{{ ing.name }}</span>
          <b>×{{ ing.qty }}</b>
        </li>
        {%- endfor %}
      </ul>
    {% else %}
      <p class="muted" data-en="No recipe on the wiki (base ingredient or very recent content)." data-es="Sin receta en la wiki (ingrediente base o contenido muy reciente).">No recipe on the wiki (base ingredient or very recent content).</p>
    {% endif %}
    {% if r.note %}<p class="muted" data-en="{{ r.note }}" data-es="{{ r.noteEs }}">{{ r.note }}</p>{% endif %}
    {% if r.page == false %}
    <a class="wiki" href="https://valheim.fandom.com/wiki/Special:Search?query={{ w | urlencode }}" target="_blank" rel="noopener" data-en="Search the wiki ↗" data-es="Buscar en la wiki ↗">Search the wiki ↗</a>
    {% else %}
    <a class="wiki" href="https://valheim.fandom.com/wiki/{{ w | replace(' ', '_') | urlencode }}" target="_blank" rel="noopener" data-en="View on the wiki ↗" data-es="Ver en la wiki ↗">View on the wiki ↗</a>
    {% endif %}
  </div>
</article>
