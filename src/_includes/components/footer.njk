{#- Pie común en una franja: aviso (IA y proyecto de fans) | legales | redes #}
<footer class="foot">
  <div class="foot-in">
    <p data-en="Made with the help of AI; may contain mistakes. Unofficial, free and ad-free fan project. Valheim © Iron Gate AB." data-es="Hecho con ayuda de IA; puede contener errores. Proyecto de fans no oficial, gratuito y sin anuncios. Valheim © Iron Gate AB.">Made with the help of AI; may contain mistakes. Unofficial, free and ad-free fan project. Valheim © Iron Gate AB.</p>
    <nav class="foot-nav" aria-label="Legal" data-en-label="Legal" data-es-label="Legal">
      <a href="legal.html" data-en="Legal notice" data-es="Aviso legal">Legal notice</a>
      <a href="privacy.html" data-en="Privacy" data-es="Privacidad">Privacy</a>
    </nav>
    <ul class="social">
      {%- for s in [
        ['GitHub repository', 'Repositorio en GitHub', 'https://github.com/sdurutr436/valheim-tracker', 'github-logo'],
        ['X (Twitter)', 'X (Twitter)', 'https://x.com/soyusuardo', 'x-logo'],
        ['LinkedIn', 'LinkedIn', 'https://www.linkedin.com/in/sergio-duran-utrera/', 'linkedin-logo']
      ] %}
      <li><a href="{{ s[2] }}" target="_blank" rel="noopener" aria-label="{{ s[0] }}" data-en-label="{{ s[0] }}" data-es-label="{{ s[1] }}">{% icon s[3] %}</a></li>
      {%- endfor %}
    </ul>
  </div>
</footer>
