---
layout: base.njk
title:
  en: Valheim · Achievement tracker
  es: Valheim · Tracker de logros
scripts: [model, app]
---
{#- Sin partida en este navegador se empieza por la pantalla de inicio de sesión #}
<script>hasSave() || location.replace('session.html');</script>
{%- from "components/section.njk" import section %}
<div class="wrap">
  {% include "components/header.njk" %}
  {% include "components/tabs.njk" %}
  <div class="layout">
    {% include "components/spy.njk" %}
    <main>
      {% include "components/toolbar.njk" %}
      {% include "components/guide.njk" %}
      {#- Un panel por lista. Master Chef, Gourmet y Chef × Gourmet comparten el de cocina (app.js filtra) #}
      {%- for ns, list in tracker.sections %}
      <div class="panel" id="panel-{{ ns }}" data-ns="{{ ns }}" hidden>
        {%- for s in list %}
        {%- call section(ns, s.biome) %}
          {%- if ns in ['hunter', 'trophy', 'fish'] %}
          <table class="rows-table">
            <thead class="sr-only"><tr>
              <th scope="col" data-en="Name" data-es="Nombre">Name</th>
              {%- if ns == 'fish' %}<th scope="col" data-en="Bait" data-es="Cebo">Bait</th>{% endif %}
              <th scope="col" data-en="Status" data-es="Estado">Status</th>
            </tr></thead>
            <tbody class="rows">
              {%- for r in s.rows %}
              {% include "components/row.njk" %}
              {%- endfor %}
            </tbody>
          </table>
          {%- else %}
          {% include "components/materials.njk" %}
          <div class="grid rows">
            {%- for r in s.rows %}
            {% include "components/card.njk" %}
            {%- endfor %}
          </div>
          {%- endif %}
        {%- endcall %}
        {%- endfor %}
      </div>
      {%- endfor %}
      <p class="empty" id="empty" hidden data-en="Nothing matches. Try another name or status." data-es="Nada coincide. Prueba otro nombre u otro estado.">Nothing matches. Try another name or status.</p>
    </main>
  </div>
</div>
<script type="application/json" id="tracker-data">{{ tracker.client | dump | safe }}</script>
